#!/usr/bin/env sh
# Run the career chat cache test on each pushed commit that changes the chat AI code.
ZERO=0000000000000000000000000000000000000000
ROOT=$(git rev-parse --show-toplevel)
MODULES="$ROOT/node_modules"
[ -d "$MODULES" ] || MODULES="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/node_modules"
if [ ! -d "$MODULES" ]; then
  echo "[cache-check] node_modules를 찾지 못했습니다. pnpm install 후 다시 push 하세요."
  exit 1
fi
TMP=$(mktemp -d)
trap 'git worktree remove --force "$TMP/wt" >/dev/null 2>&1 || true; rm -rf "$TMP"' EXIT
trap 'exit 1' INT TERM HUP

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  if [ "$REMOTE_SHA" = "$ZERO" ] || ! git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    BASE=$(git merge-base origin/main "$LOCAL_SHA" 2>/dev/null || true)
  else
    BASE=$REMOTE_SHA
  fi
  if [ -n "$BASE" ] && [ -z "$(git diff --name-only "$BASE" "$LOCAL_SHA" -- src/lib/career src/lib/llm src/lib/talentOnboarding)" ]; then
    continue
  fi

  echo "[cache-check] $REMOTE_REF: 채팅 AI 코드가 바뀌어 캐시 검사를 돌립니다..."
  git worktree remove --force "$TMP/wt" >/dev/null 2>&1 || true
  git worktree add --quiet --detach "$TMP/wt" "$LOCAL_SHA" || exit 1
  ln -s "$MODULES" "$TMP/wt/node_modules"
  if ! (cd "$TMP/wt" && node --import tsx --test src/lib/career/llm.cache.test.ts); then
    echo "[cache-check] 캐시 검사 실패: 답 하나 안에서 AI 요청 앞부분이 바뀝니다. 위 실패 내용을 확인하세요."
    exit 1
  fi
done
