{
  "name": "harper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:slack-socket": "node --env-file=.env.local scripts/slackLocalSocketBridge.mjs",
    "dev:slack-review-post": "node --env-file=.env.local --import tsx scripts/postLocalSlackTalentReview.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "growth:ga-slack-report": "node scripts/sendGrowthCandidateGaSlackReport.mjs",
    "ops:auto-intro:list": "tsx --tsconfig scripts/tsconfig.json scripts/autoIntroToCompanyCodexScheduled.ts list",
    "ops:auto-intro:send": "tsx --tsconfig scripts/tsconfig.json scripts/autoIntroToCompanyCodexScheduled.ts send",
    "org-agent:live-eval": "tsx --tsconfig scripts/tsconfig.json scripts/evalOrgAgentLive.ts",
    "org-role-creation:llm-eval": "tsx --tsconfig scripts/tsconfig.json scripts/evalOrgRoleCreationLlm.ts",
    "org-role-creation:live-smoke": "tsx --tsconfig scripts/tsconfig.json scripts/smokeOrgRoleCreationLive.ts",
    "org-agent:prompt-snapshot": "tsx --tsconfig scripts/tsconfig.json scripts/exportOrgAgentPromptSnapshot.ts",
    "org-agent:prompt-benchmark": "tsx scripts/benchmarkOrgAgentPrompt.ts",
    "test:org-agent:db": "node --import tsx scripts/testOrgAgentDb.ts",
    "ops:workspace:sync-list": "node scripts/syncCompanyWorkspacesFromList.mjs",
    "translation:check-career": "node scripts/translation-extract-career.mjs --check",
    "translation:extract-career": "node scripts/translation-extract-career.mjs",
    "translation:pull": "node scripts/translation-pull.mjs",
    "translation:push": "node scripts/translation-push.mjs",
    "translation:sync": "node scripts/translation-sync-career.mjs --translate --push-db",
    "translation:sync:dry": "node scripts/translation-sync-career.mjs --dry-run",
    "prepare": "husky"
  },
