    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.181.2",
    "threejs-components": "^0.0.27",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "utf-8-validate": "^6.0.6",
    "uuid": "^10.0.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.8"
